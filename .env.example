# Variáveis de ambiente do Trancoso Resolve
# Copie para .env e preencha. Nunca versione o .env.
#
# ATENÇÃO: variáveis VITE_* são embutidas no bundle e ficam visíveis
# no navegador. Proteja-as por restrição de origem no provedor,
# nunca por sigilo do valor.

# Google Maps JavaScript API
# Restrinja a chave por referrer HTTP no Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Base44
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=

# Stripe (chave publicável)
VITE_STRIPE_PUBLISHABLE_KEY=
