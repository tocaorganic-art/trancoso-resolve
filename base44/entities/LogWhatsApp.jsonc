{
  "name": "LogWhatsApp",
  "type": "object",
  "properties": {
    "prestador_id": {
      "type": "string",
      "description": "ID do ServiceProvider destinatário"
    },
    "direcao": {
      "type": "string",
      "enum": [
        "saida",
        "entrada"
      ],
      "default": "saida",
      "description": "Direção da mensagem: saida (enviada pelo sistema) ou entrada (recebida do usuário)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "boas_vindas_plano",
        "lead_novo",
        "lembrete_renovacao",
        "verificacao_aprovada",
        "aviso_admin",
        "mensagem_recebida",
        "status_entrega"
      ],
      "description": "Tipo do evento"
    },
    "telefone": {
      "type": "string",
      "description": "Número no formato E.164 (destino para saída, remetente para entrada)"
    },
    "mensagem": {
      "type": "string",
      "description": "Texto da mensagem"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "entregue",
        "lido",
        "falhou"
      ],
      "default": "pendente",
      "description": "Status do envio/entrega"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem retornado pelo provedor (WhatsApp Business API / Z-API / etc)"
    },
    "erro": {
      "type": "string",
      "description": "Detalhes do erro em caso de falha"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "referencia_id": {
      "type": "string",
      "description": "ID do objeto relacionado (Subscription, ServiceRequest, etc)"
    },
    "referencia_tipo": {
      "type": "string",
      "description": "Tipo do objeto relacionado (Subscription, ServiceRequest, etc)"
    }
  },
  "required": [
    "tipo",
    "telefone"
  ],
  "rls": {
    "read": {
      "created_by": "admin"
    },
    "write": {
      "created_by": "admin"
    }
  }
}
