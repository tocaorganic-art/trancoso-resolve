{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo do prestador"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "cover_photo_url": {
      "type": "string",
      "description": "URL da foto de capa do perfil (16:9, alta qualidade)"
    },
    "occupation": {
      "type": "string",
      "enum": [
        "Limpeza",
        "Garçom",
        "Pedreiro",
        "Jardinagem",
        "Babá",
        "Eletricista",
        "Encanador",
        "Pintor",
        "Cozinheiro",
        "Outro"
      ],
      "description": "Ocupação principal"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email"
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "pf",
        "mei",
        "pj"
      ],
      "default": "pf",
      "description": "Tipo de pessoa: PF (pessoa física), MEI ou PJ (empresa/CNPJ)"
    },
    "tem_ponto_fisico_em_trancoso": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a empresa/MEI possui ponto físico em Trancoso (loja, restaurante, pousada, etc.)"
    },
    "razao_social": {
      "type": "string",
      "description": "Razão social (para PJ/MEI)"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia (para PJ/MEI)"
    },
    "bio": {
      "type": "string",
      "description": "Biografia/descrição profissional"
    },
    "experience_years": {
      "type": "integer",
      "description": "Anos de experiência"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Especialidades e diferenciais"
    },
    "price_range": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$"
      ],
      "description": "Faixa de preço"
    },
    "rates": {
      "type": "object",
      "properties": {
        "hourly": {
          "type": "number"
        },
        "daily": {
          "type": "number"
        },
        "per_project": {
          "type": "number"
        }
      },
      "description": "Valores de referência"
    },
    "location": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "neighborhood": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "coverage_radius_km": {
          "type": "number"
        }
      }
    },
    "availability": {
      "type": "string",
      "enum": [
        "Disponível",
        "Ocupado",
        "Indisponível"
      ],
      "default": "Disponível"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Avaliação média (calculado pelo sistema)"
    },
    "total_reviews": {
      "type": "integer",
      "default": 0,
      "description": "Total de avaliações (calculado pelo sistema)"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Prestador verificado pela plataforma — SOMENTE atualizável via function adminVerificacao ou atualizarStatusVerificacao"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Imagens do portfólio (antes/depois)"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Dinheiro",
          "PIX",
          "Cartão de Débito",
          "Cartão de Crédito"
        ]
      },
      "description": "Métodos de pagamento aceitos"
    },
    "status_verificacao": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "em_analise_manual",
        "reprovado"
      ],
      "default": "pendente",
      "description": "Status da verificação de antecedentes criminais — SOMENTE atualizável via function atualizarStatusVerificacao"
    },
    "relatorio_verificacao": {
      "type": "string",
      "description": "Resumo do resultado da verificação de antecedentes — SOMENTE atualizável via function atualizarStatusVerificacao"
    },
    "data_verificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da última verificação concluída — atualizável só pelo sistema"
    },
    "status_verificacao_empresa": {
      "type": "string",
      "enum": [
        "pendente",
        "regular",
        "em_risco"
      ],
      "default": "pendente",
      "description": "Status da verificação cadastral do CNPJ na Receita Federal — SOMENTE atualizável via function atualizarStatusVerificacao"
    },
    "relatorio_verificacao_empresa": {
      "type": "string",
      "description": "Relatório da verificação do CNPJ — SOMENTE atualizável via function atualizarStatusVerificacao"
    }
  },
  "required": [
    "full_name",
    "occupation"
  ],
  "rls": {
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } },
        {
          "_comment": "Leitura pública permite apenas campos não-sensíveis. A filtragem de campos PII é responsabilidade das functions e do frontend. CPF, CNPJ, documentos e fotos de verificação foram migrados para ServiceProviderPrivate.",
          "_public": true
        }
      ]
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$and": [
        { "created_by": "{{user.email}}" },
        {
          "_comment": "verified, status_verificacao, relatorio_verificacao, data_verificacao, status_verificacao_empresa, relatorio_verificacao_empresa, rating, total_reviews NUNCA devem ser enviados pelo frontend. São controlados exclusivamente pelas functions atualizarStatusVerificacao e adminVerificacao via service role."
        }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
